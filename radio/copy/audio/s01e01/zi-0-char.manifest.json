    "duration": 0.2,
    "running_start_time": 89.76163400000002
  },
  {
    "segment_type": "line",
    "source_id": "Sunshine-5e9d7c3ac3535136.mp3",
    "speaker": "Sunshine",
    "text": "[brightly] That's what I've been told! Okay, so, if you're going to break a rule by introducing four characters at once, I'm going to cheat too and use some sentences so the listeners can get a feel for what these words sound like.",
    "duration": 12.277551,
    "running_start_time": 89.96163400000002,
    "alignment": "Sunshine-5e9d7c3ac3535136.json"
  },
  {
    "segment_type": "gap",
    "source_id": null,
    "duration": 0.2,
    "running_start_time": 102.23918500000002
  },
  {
    "segment_type": "line",
    "source_id": "Rob-27e5fd4c867399d6.mp3",
    "speaker": "Rob",
    "text": "That sounds fair...",
